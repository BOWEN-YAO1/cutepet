<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CutePet</AssemblyName>
    <Version>0.23.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../CutePet.Codex/CutePet.Codex.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Characters/Packs/**/*.png" /><Resource Include="Characters/Packs/**/character.json" /><Resource Include="Characters/Packs/**/*.txt" /><Resource Include="Characters/Packs/**/SOURCE.md" /></ItemGroup>
</Project>
