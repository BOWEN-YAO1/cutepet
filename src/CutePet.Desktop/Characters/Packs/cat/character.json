  "dialogue": {
    "startup": [
      "喵，今天也来陪你。",
      "小猫报到，尾巴准备好啦。"
    ],
    "morning": [
      "早安喵，伸个懒腰。",
      "太阳来了，小猫也醒了。"
    ],
    "evening": [
      "晚上好喵，别忙得太晚。",
      "夜深啦，小猫陪你慢慢来。"
    ],
    "click": [
      "喵？是在叫我吗？",
      "收到一份摸摸，呼噜呼噜。"
    ],
    "hover": [
      "看到你啦，喵。",
      "靠近一点，蹭蹭。"
    ],
    "drag": [
      "新窝也不错，喵。",
      "搬家完成，小猫坐好。"
    ],
    "cloud": [
      "云像软软的棉花，喵。",
      "搭朵云去兜风啦。"
    ],
    "rest": [
      "团成小毛球，歇一歇。",
      "坐下啦，尾巴也休息。"
    ],
    "wake": [
      "睡饱啦，喵。",
      "伸个懒腰，继续陪你。"
    ],
    "edge-side": [
      "从这里探头，喵。",
      "藏不住小耳朵啦。"
    ],
    "edge-top": [
      "高处的风景真好，喵。",
      "小猫在上面看着你。"
    ],
    "edge-bottom": [
      "在下面乖乖陪你，喵。",
      "找了个舒服的小角落。"
    ],
    "ambient": [
      "小猫在呢，慢慢来。",
      "喝口水吧，小猫也要休息。"
    ],
    "low": [
      "额度不多了，喵，留意一下。",
      "小猫提醒：剩余额度有点少。"
    ],
    "recovery": [
      "最新额度回来啦，喵。",
      "额度状态更新，小猫继续看着。"
    ],
    "offline": [
      "没连上喵，等一等。",
      "暂时看不到最新额度，小猫陪你等。"
    ]
  }
