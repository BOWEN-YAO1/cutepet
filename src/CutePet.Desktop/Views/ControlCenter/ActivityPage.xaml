<UserControl x:Class="CutePet.Desktop.ActivityPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CenterTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
      <TextBlock Text="让伙伴自在活动" Style="{StaticResource CenterHeading}"/>
      <TextBlock Text="{Binding ActivityText}" Style="{StaticResource CenterNote}" Margin="0,0,0,24"/>
      <Border Background="#FDFEF9" CornerRadius="14" Padding="24">
        <StackPanel>
          <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"><TextBlock Text="自由乘云活动" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <CheckBox x:Name="AutoCloudSwitch" IsChecked="{Binding AutoCloud, Mode=TwoWay}" IsEnabled="{Binding CanCloud}" Style="{StaticResource CenterToggle}" AutomationProperties.Name="自由乘云活动"/></StackPanel>
            <StackPanel><TextBlock Text="乘云游动" Style="{StaticResource CenterSection}"/><TextBlock Text="{Binding CloudHint}" Style="{StaticResource CenterNote}" MaxWidth="460" HorizontalAlignment="Left"/></StackPanel>
          </DockPanel>
          <WrapPanel><Button x:Name="RoamButton" Content="乘云去逛逛" Command="{Binding RoamCommand}" Style="{StaticResource CenterPrimary}"/><Button Content="召回到额度旁" Command="{Binding RecallCommand}"/></WrapPanel>
          <Border BorderBrush="#E3E9DF" BorderThickness="0,1,0,0" Margin="0,24,0,22"/>
          <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"><TextBlock Text="自动坐下休息" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <CheckBox x:Name="AutoRestSwitch" IsChecked="{Binding AutoRest, Mode=TwoWay}" IsEnabled="{Binding CanAutoRest}" Style="{StaticResource CenterToggle}" AutomationProperties.Name="自动坐下休息"/></StackPanel>
            <StackPanel><TextBlock Text="王座休息" Style="{StaticResource CenterSection}"/><TextBlock Text="{Binding RestHint}" Style="{StaticResource CenterNote}" MaxWidth="460" HorizontalAlignment="Left"/></StackPanel>
          </DockPanel>
          <Button x:Name="RestButton" Content="{Binding RestAction}" Command="{Binding RestCommand}" HorizontalAlignment="Left"/>
          <Border BorderBrush="#E3E9DF" BorderThickness="0,1,0,0" Margin="0,24,0,22"/>
          <DockPanel>
            <CheckBox x:Name="EdgeSwitch" DockPanel.Dock="Right" IsChecked="{Binding EdgeInteraction, Mode=TwoWay}" IsEnabled="{Binding CanEdge}" Style="{StaticResource CenterToggle}" AutomationProperties.Name="屏幕边缘互动" Margin="20,0,0,0"/>
            <StackPanel><TextBlock Text="屏幕边缘互动" Style="{StaticResource CenterSection}"/>
              <TextBlock Text="把人物拖到屏幕边缘并松开：上沿荡秋千，下沿托腮，左右探头。需要角色包提供对应动作。" Style="{StaticResource CenterNote}"/>
              <TextBlock Text="位置锁定后无法拖动。任务栏会按屏幕可用区域避让。" Style="{StaticResource CenterNote}" Margin="0,5,0,0"/></StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
      <WrapPanel Margin="0,18,0,12"><Button Content="回应一下" Command="{Binding GreetCommand}"/><Button Content="{Binding VisibilityAction}" Command="{Binding VisibilityCommand}" Style="{StaticResource CenterQuiet}"/></WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
