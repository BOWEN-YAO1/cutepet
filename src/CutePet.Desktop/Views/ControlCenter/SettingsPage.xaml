<UserControl x:Class="CutePet.Desktop.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CenterTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
      <Border Background="#FDFEF9" CornerRadius="14" Padding="24">
        <StackPanel>
          <TextBlock Text="桌面显示" Style="{StaticResource CenterSection}"/>
          <DockPanel Margin="0,4,0,18"><CheckBox x:Name="TopmostSwitch" DockPanel.Dock="Right" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" Style="{StaticResource CenterToggle}" AutomationProperties.Name="桌宠与额度始终置顶" Margin="20,0,0,0"/>
            <TextBlock Text="始终置顶" FontSize="14"/></DockPanel>
          <DockPanel Margin="0,0,0,20"><CheckBox x:Name="LockSwitch" DockPanel.Dock="Right" IsChecked="{Binding PositionLocked, Mode=TwoWay}" Style="{StaticResource CenterToggle}" AutomationProperties.Name="锁定位置" Margin="20,0,0,0"/>
            <TextBlock Text="锁定位置" FontSize="14" ToolTip="锁定人物和额度的位置，并暂停乘云移动。"/></DockPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0"><TextBlock Text="人物大小" Margin="0,0,0,8"/><ComboBox x:Name="CharacterSize" ItemsSource="{Binding Scales}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CharacterScale, Mode=TwoWay}" AutomationProperties.Name="人物大小"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="额度数字大小" Margin="0,0,0,8"/><ComboBox x:Name="QuotaSize" ItemsSource="{Binding Scales}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding QuotaScale, Mode=TwoWay}" AutomationProperties.Name="额度数字大小"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="额度详情" Margin="0,0,0,8"/><ComboBox x:Name="DetailsChoice" ItemsSource="{Binding DetailChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Details, Mode=TwoWay}" AutomationProperties.Name="额度详情显示方式"/></StackPanel>
          </Grid>
          <TextBlock Text="额度条快速摆放" FontSize="14" Margin="0,22,0,9"/>
          <ItemsControl ItemsSource="{Binding Docks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.DockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Value}" Margin="0,0,8,7"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
      <Border Background="#FDFEF9" CornerRadius="14" Padding="24" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="启动与连接" Style="{StaticResource CenterSection}"/>
          <DockPanel Margin="0,4,0,20"><CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Style="{StaticResource CenterToggle}" AutomationProperties.Name="开机启动" Margin="20,0,0,0"/>
            <TextBlock Text="开机启动" FontSize="14"/></DockPanel>
          <TextBlock Text="Codex 程序" FontSize="14" Margin="0,0,0,8"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="选择程序…" Command="{Binding PathCommand}" Margin="16,0,0,0" ToolTip="更改后重新启动 CutePet 生效。"/>
            <TextBlock x:Name="CodexPath" Text="{Binding CodexPathText}" Style="{StaticResource CenterNote}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CodexPathText}"/></DockPanel>
        </StackPanel>
      </Border>
      <WrapPanel Margin="0,20,0,14"><Button Content="移回屏幕右下角" Command="{Binding ResetCommand}"/><Button Content="退出 CutePet" Command="{Binding ExitCommand}" Style="{StaticResource CenterQuiet}"/></WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
