<Window x:Class="CutePet.Desktop.ControlCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CutePet" Width="1000" Height="740" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CenterBackground}" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource CenterInk}">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CenterTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Background="{DynamicResource CenterBackground}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="30,23,28,14">
      <StackPanel Orientation="Horizontal">
        <Image Source="{StaticResource BrandIcon}" Width="42" Height="42" Margin="0,0,12,0" AutomationProperties.Name="CutePet 小猫图标"/>
        <TextBlock Text="CutePet" FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource CenterLine}" BorderThickness="0,0,0,1" Margin="28,0">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="OverviewTab" Content="概览" GroupName="Pages" Tag="overview" Style="{StaticResource CenterNav}" Checked="OnNavigate"/>
        <RadioButton x:Name="CharactersTab" Content="角色" GroupName="Pages" Tag="characters" Style="{StaticResource CenterNav}" Checked="OnNavigate"/>
        <RadioButton x:Name="ActivityTab" Content="活动" GroupName="Pages" Tag="activity" Style="{StaticResource CenterNav}" Checked="OnNavigate"/>
        <RadioButton x:Name="SettingsTab" Content="设置" GroupName="Pages" Tag="settings" Style="{StaticResource CenterNav}" Checked="OnNavigate"/>
      </StackPanel>
    </Border>
    <ContentControl x:Name="PageHost" Grid.Row="2" Margin="30,24,30,18" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Border Grid.Row="3" BorderBrush="{DynamicResource CenterLine}" BorderThickness="0,1,0,0" Padding="30,12" Background="{DynamicResource CenterSoft}">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource CenterMuted}" FontSize="13" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
