<UserControl x:Class="CutePet.Desktop.CharactersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CenterTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22"><Button x:Name="ImportButton" DockPanel.Dock="Right" Content="导入角色…" Click="OnImport" Style="{StaticResource CenterPrimary}" Margin="15,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="CurrentUseText" FontSize="14" VerticalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="CharacterList" SelectionChanged="OnSelectionChanged" Background="{DynamicResource CenterSurface}" Foreground="{DynamicResource CenterInk}" BorderThickness="0" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="9,12"/><Setter Property="Margin" Value="0,0,0,4"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CenterSoft}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CenterAccent}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CenterAccent}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="22,0,0,0">
        <StackPanel>
          <Border Background="{DynamicResource CenterSoft}" CornerRadius="14" Height="170">
            <Grid><Border x:Name="SidePreviewEdge" Width="2" Background="{DynamicResource CenterLine}" HorizontalAlignment="Center" Margin="0,12,0,24" Visibility="Collapsed" IsHitTestVisible="False"/>
              <Border x:Name="BottomPreviewEdge" Height="2" Background="{DynamicResource CenterLine}" VerticalAlignment="Bottom" Margin="16,0,16,24" Visibility="Collapsed" IsHitTestVisible="False"/>
              <Canvas x:Name="TopPreviewRopes" Margin="16,12,16,24" Visibility="Collapsed" IsHitTestVisible="False">
                <Line x:Name="TopPreviewLeft" Stroke="{DynamicResource CenterInk}" StrokeThickness="1"/>
                <Line x:Name="TopPreviewRight" Stroke="{DynamicResource CenterInk}" StrokeThickness="1"/>
              </Canvas>
              <Image x:Name="CloudPreview" Width="140" Height="32" VerticalAlignment="Bottom" Margin="0,0,0,12" Opacity="0" Stretch="Uniform"/>
              <Image x:Name="Preview" Margin="16,12,16,24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="所选角色动作预览"/></Grid>
          </Border>
          <TextBlock x:Name="CharacterInfo" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,14"/>
          <WrapPanel Margin="0,0,0,10"><Button x:Name="UseButton" Content="使用此角色" Style="{StaticResource CenterPrimary}" Click="OnUse"/>
            <ComboBox x:Name="PreviewAction" Width="126" Margin="0,0,8,0" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="预览动作"/>
            <Button x:Name="PreviewButton" Content="播放动作" Click="OnPreview"/></WrapPanel>
          <WrapPanel Margin="0,0,0,12"><Button x:Name="ExportButton" Content="导出角色包…" Click="OnExport"/>
            <Button x:Name="RemoveButton" Content="移除角色" Click="OnRemove" Style="{StaticResource CenterQuiet}"/></WrapPanel>
          <Expander Header="素材信息"><TextBlock x:Name="RightsInfo" TextWrapping="Wrap" Style="{StaticResource CenterNote}" Margin="0,8,0,0"/></Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource CenterMuted}" Margin="0,16,0,0">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
  </Grid>
</UserControl>
