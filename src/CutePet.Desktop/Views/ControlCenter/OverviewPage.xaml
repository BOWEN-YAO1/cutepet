<UserControl x:Class="CutePet.Desktop.OverviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CenterTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,8,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <Border Background="#FDFEF9" CornerRadius="14" Padding="20" Margin="0,0,20,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="刷新额度" Command="{Binding RefreshCommand}" Margin="0" Padding="12,6" MinHeight="32"/>
              <TextBlock Text="Codex 剩余额度" Style="{StaticResource CenterSection}" VerticalAlignment="Center" Margin="0"/></DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Ellipse Width="6" Height="6" Fill="{Binding Quota.StatusBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="QuotaStatus" Text="{Binding Quota.StatusText}" Style="{StaticResource CenterNote}"/></StackPanel>
            <ItemsControl x:Name="QuotaRows" ItemsSource="{Binding Quota.Windows}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,4,0,12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" Foreground="{Binding Accent}"/>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0"/></DockPanel>
                  <ProgressBar Grid.Row="1" Value="{Binding Progress}" Maximum="100" Foreground="{Binding Accent}" Opacity="{Binding Opacity}"/>
                  <TextBlock Grid.Row="2" Text="{Binding ResetText}" Style="{StaticResource CenterNote}" Margin="0,7,0,0"/>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="#E3E9DF" BorderThickness="0,1,0,0" Padding="0,13,0,0">
              <TextBlock Text="{Binding Quota.FooterText}" Style="{StaticResource CenterNote}"/>
            </Border>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#E3EBDD" CornerRadius="14" Padding="20">
          <StackPanel>
            <Image x:Name="PetPreview" Source="{Binding CharacterImage}" Height="160" Stretch="Uniform" Margin="0,8,0,10" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="当前角色预览"/>
            <TextBlock Text="{Binding CharacterName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ActivityText}" Style="{StaticResource CenterNote}" Margin="0,6,0,14"/>
            <Button Content="{Binding VisibilityAction}" Command="{Binding VisibilityCommand}" Style="{StaticResource CenterPrimary}" Margin="0,0,0,8"/>
            <Button Content="召回到额度旁" Command="{Binding RecallCommand}" Margin="0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
