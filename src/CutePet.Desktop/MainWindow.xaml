<Window x:Class="CutePet.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CutePet" Width="352" Height="184"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual" PreviewKeyDown="OnDockKeyDown">
  <Viewbox x:Name="Viewport" Stretch="Uniform">
    <Canvas x:Name="Scene" Width="352" Height="184" Focusable="True" MouseLeftButtonDown="OnMouseDown"
          MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp" MouseEnter="OnHoverEnter" MouseLeave="OnHoverLeave"
          LostMouseCapture="OnDockCaptureLost">
      <Border x:Name="DockTarget" CornerRadius="14" BorderBrush="#568B70" BorderThickness="2" Background="#24568B70"
              IsHitTestVisible="False" Visibility="Collapsed" />
      <Viewbox x:Name="PetStage" Width="230" Height="178" Canvas.Left="110" Canvas.Top="2" Stretch="Uniform">
       <Grid Width="230" Height="178">
        <Ellipse Fill="#2029443B" Width="108" Height="13" VerticalAlignment="Bottom" Margin="0,0,0,1" />
        <Grid x:Name="PetArt" RenderTransformOrigin="0.5,0.85" Margin="0,16,0,14">
          <Grid.RenderTransform><TranslateTransform x:Name="Bob" /></Grid.RenderTransform>
          <Viewbox x:Name="CatArt" Width="166" Height="148" VerticalAlignment="Bottom">
            <Canvas Width="180" Height="160">
              <Path Fill="#A9CDBB" Stroke="#3D6858" StrokeThickness="3" StrokeLineJoin="Round"
                    Data="M 54,95 C 15,80 10,116 42,124 C 32,142 56,155 92,150 C 133,155 159,142 146,121 C 167,96 146,79 128,95 Z" />
              <Path Fill="#FFF9ED" Stroke="#3D6858" StrokeThickness="3" StrokeLineJoin="Round"
                    Data="M 37,46 L 28,12 Q 29,3 38,8 L 65,27 Q 89,19 116,28 L 142,8 Q 151,3 151,15 L 142,49 C 167,97 141,118 91,118 C 41,118 13,95 37,46 Z" />
              <Path Fill="#E8C8B6" Data="M 37,17 L 43,44 L 58,32 Z M 139,17 L 133,44 L 119,32 Z" />
              <Ellipse Fill="#EED5C4" Width="19" Height="9" Canvas.Left="43" Canvas.Top="76" />
              <Ellipse Fill="#EED5C4" Width="19" Height="9" Canvas.Left="119" Canvas.Top="76" />
              <Ellipse x:Name="LeftEye" Fill="#345449" Width="7" Height="13" Canvas.Left="64" Canvas.Top="62" />
              <Ellipse x:Name="RightEye" Fill="#345449" Width="7" Height="13" Canvas.Left="108" Canvas.Top="62" />
              <Path Stroke="#345449" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 80,79 Q 85,86 90,79 Q 95,86 100,79" />
              <Path Fill="#3D6858" Data="M 51,109 Q 90,124 130,109 L 130,121 Q 89,136 50,121 Z" />
              <Ellipse Fill="#FFF9ED" Stroke="#3D6858" StrokeThickness="2" Width="26" Height="26" Canvas.Left="78" Canvas.Top="116" />
              <TextBlock Text="C" FontFamily="Segoe UI" FontWeight="Bold" FontSize="18" Foreground="#3D6858" Canvas.Left="85" Canvas.Top="117" />
              <Path Fill="#FFF9ED" Stroke="#3D6858" StrokeThickness="2.5" Data="M 57,129 Q 44,136 56,145 L 68,145 Q 76,137 66,130 Z M 119,129 Q 105,137 117,145 L 129,145 Q 137,137 127,130 Z" />
            </Canvas>
          </Viewbox>
          <Image x:Name="TianyiArt" Width="178" Height="148" Stretch="Uniform" VerticalAlignment="Bottom"
                 Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
        <Border x:Name="SpeechBubble" Background="#FFF9ED" CornerRadius="10" BorderBrush="#D8E5DB" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-26,4,0,0" Padding="10,6" MaxWidth="110"
                Visibility="{Binding ShowCharacterMessage, Converter={StaticResource VisibleWhenTrue}}">
          <TextBlock Text="{Binding CharacterMessage}" FontSize="11" Foreground="#456054" TextWrapping="Wrap" />
        </Border>
       </Grid>
      </Viewbox>
      <Viewbox x:Name="QuotaCard" Canvas.Left="12" Canvas.Top="104" Width="116" Height="68" Cursor="SizeAll" Stretch="Uniform">
       <Border x:Name="QuotaSurface" Width="116" Height="68"
              CornerRadius="12" Background="#FFFAF4" BorderBrush="#D9E3DB" BorderThickness="1">
          <ItemsControl ItemsSource="{Binding CompactWindows}" Margin="8,4">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CompactColumns, RelativeSource={RelativeSource AncestorType=Window}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,0" VerticalAlignment="Center" ToolTip="{Binding Label}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ShortLabel}" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="#74877B" VerticalAlignment="Center" Margin="0,0,5,0" />
                  <TextBlock Grid.Column="1" Text="{Binding RemainingText}" FontSize="23" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{Binding Accent}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
       </Border>
      </Viewbox>
      <Border x:Name="DockHint" Background="#FFF9ED" CornerRadius="7" Padding="7,4" IsHitTestVisible="False" Visibility="Collapsed">
        <TextBlock x:Name="DockHintText" FontSize="10" Foreground="#345449" />
      </Border>
      <Popup x:Name="DetailsPopup" PlacementTarget="{Binding ElementName=Scene}" Placement="Top"
             AllowsTransparency="True" StaysOpen="True" Opened="OnDetailsOpened">
        <Viewbox x:Name="DetailsViewport" Width="348" Height="256" Stretch="Uniform"
                 MouseEnter="OnHoverEnter" MouseLeave="OnHoverLeave">
          <Grid x:Name="DetailsScene" Width="348" Height="256" Background="Transparent">
      <Border Margin="12,8,12,8" CornerRadius="18" Background="#FFFAF4" BorderBrush="#D9E3DB" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#244A3B" BlurRadius="13" ShadowDepth="3" Opacity="0.13" /></Border.Effect>
        <Grid Margin="17,15,17,13">
          <Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="25" /><RowDefinition Height="*" /><RowDefinition Height="33" /></Grid.RowDefinitions>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="收起" FontSize="10" Padding="6,3" Background="Transparent" Click="OnCollapseDetails" ToolTip="收起详情，返回悬停模式" />
            <Button x:Name="PinDetailsButton" DockPanel.Dock="Right" Content="固定" FontSize="10" Padding="6,3" Background="Transparent" Click="OnPinDetails" ToolTip="固定显示详情，或恢复悬停显示" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="CUTEPET" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#345449" />
              <TextBlock Text=" / CODEX" FontFamily="Segoe UI" FontSize="10" Foreground="#91A397" Margin="3,2,0,0" />
            </StackPanel>
          </DockPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding StatusText}" Foreground="#74877B" FontSize="10" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Windows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4,0,9">
                    <Grid.RowDefinitions><RowDefinition Height="23" /><RowDefinition Height="8" /><RowDefinition Height="17" /></Grid.RowDefinitions>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontSize="18" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{Binding Accent}" />
                      <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#465C50" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Grid.Row="1" Maximum="100" Value="{Binding Progress}" Foreground="{Binding Accent}" Opacity="{Binding Opacity}" />
                    <TextBlock Grid.Row="2" Text="{Binding ResetText}" FontSize="10" Foreground="#8A9B8D" Margin="0,3,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <DockPanel Grid.Row="3" VerticalAlignment="Bottom">
            <Button DockPanel.Dock="Right" Content="刷新" FontSize="10" Click="OnRefresh" IsEnabled="{Binding CanRefresh}" />
            <TextBlock Text="{Binding FooterText}" FontSize="10" Foreground="#8A9B8D" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
          </DockPanel>
        </Grid>
      </Border>
          </Grid>
        </Viewbox>
      </Popup>
    </Canvas>
  </Viewbox>
</Window>
